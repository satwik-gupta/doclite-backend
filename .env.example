# Copy to .env for local dev (the app loads .env automatically).
# On Northflank, set these as environment variables on the service instead.

# --- Security ---
# Generate a strong value: python -c "import secrets;print(secrets.token_urlsafe(48))"
DOCLITE_SECRET_KEY=dev-secret-change-me-please-0123456789abcdef
DOCLITE_ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- Database ---
# Local: a file in the working dir. On Northflank the Dockerfile defaults to
# sqlite:////data/doclite.db (mount a persistent volume at /data to keep data).
DOCLITE_DATABASE_URL=sqlite:///./doclite.db

# --- Uploads ---
DOCLITE_MAX_UPLOAD_BYTES=5242880          # 5 MB

# --- CORS (split deploy: allow the Vercel frontend to call this API) ---
# Comma-separated explicit origins (local dev defaults shown). Add your Vercel
# production URL here too if you want, e.g. https://doclite-ui.vercel.app
DOCLITE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Regex that ALSO matches allowed origins. Default allows any *.vercel.app
# (production + preview deploys). Set empty to disable.
DOCLITE_CORS_ORIGIN_REGEX=https://([a-z0-9-]+\.)*vercel\.app

# --- Seeding ---
DOCLITE_SEED_ON_STARTUP=true

# --- Server port (Northflank may inject PORT; Dockerfile honors it) ---
PORT=8000
